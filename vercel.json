{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "cd app && pnpm install --frozen-lockfile",
	"buildCommand": "cd app && pnpm build && mkdir -p build/universe/babel-1 && cp -R ../lab/universes/babel-1/. build/universe/babel-1/",
	"outputDirectory": "app/build",
	"headers": [
		{
			"source": "/universe/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		},
		{
			"source": "/_app/immutable/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		}
	],
	"rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
