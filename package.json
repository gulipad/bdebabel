{
  "name": "bdebabel",
  "version": "0.1.0",
  "private": true,
  "description": "La Biblioteca de Babel, en español, con un modelo de lenguaje como cartógrafo.",
  "type": "module",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "corpus": "node --experimental-strip-types --no-warnings scripts/fetch-corpus.ts",
    "train": "node --experimental-strip-types --no-warnings --max-old-space-size=8192 scripts/train.ts",
    "babel": "node --experimental-strip-types --no-warnings --max-old-space-size=8192 src/cli.ts",
    "test": "node --experimental-strip-types --no-warnings --max-old-space-size=8192 --test 'test/**/*.test.ts'"
  }
}
