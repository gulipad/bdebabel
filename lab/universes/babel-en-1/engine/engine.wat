;; int8 matrix × int8 vector -> int32, with fixed-width WebAssembly SIMD only (deterministic everywhere).
;; Weights are row-major int8 in [-127, 127]; activations int8 in [-127, 127]; cols is a multiple of 16.
;; Per 16 columns: extmul low/high to i16 (|w·a| <= 16129, so the sum of two fits in i16), add, then
;; pairwise-widen to i32 and accumulate. Four rows at a time share each activation load.
(module
  (import "env" "mem" (memory 1))
  (func $dot (param $w i32) (param $a i32) (param $cols i32) (result v128)
    (local $acc v128) (local $c i32) (local $av v128) (local $wv v128)
    (local.set $acc (v128.const i32x4 0 0 0 0))
    (local.set $c (i32.const 0))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $c) (local.get $cols)))
      (local.set $av (v128.load (i32.add (local.get $a) (local.get $c))))
      (local.set $wv (v128.load (i32.add (local.get $w) (local.get $c))))
      (local.set $acc (i32x4.add (local.get $acc) (i32x4.extadd_pairwise_i16x8_s
        (i16x8.add (i16x8.extmul_low_i8x16_s (local.get $wv) (local.get $av))
                   (i16x8.extmul_high_i8x16_s (local.get $wv) (local.get $av))))))
      (local.set $c (i32.add (local.get $c) (i32.const 16)))
      (br $l)))
    (local.get $acc))
  (func $hsum (param $v v128) (result i32)
    (i32.add (i32.add (i32x4.extract_lane 0 (local.get $v)) (i32x4.extract_lane 1 (local.get $v)))
             (i32.add (i32x4.extract_lane 2 (local.get $v)) (i32x4.extract_lane 3 (local.get $v)))))
  ;; out[r] = sum_c W[r, c] * a[c]
  (func (export "matvec") (param $w i32) (param $a i32) (param $out i32) (param $rows i32) (param $cols i32)
    (local $r i32) (local $c i32) (local $av v128)
    (local $w0 i32) (local $w1 i32) (local $w2 i32) (local $w3 i32)
    (local $s0 v128) (local $s1 v128) (local $s2 v128) (local $s3 v128) (local $p v128)
    (local.set $r (i32.const 0))
    (block $quad_done (loop $quad
      (br_if $quad_done (i32.gt_u (i32.add (local.get $r) (i32.const 4)) (local.get $rows)))
      (local.set $w0 (i32.add (local.get $w) (i32.mul (local.get $r) (local.get $cols))))
      (local.set $w1 (i32.add (local.get $w0) (local.get $cols)))
      (local.set $w2 (i32.add (local.get $w1) (local.get $cols)))
      (local.set $w3 (i32.add (local.get $w2) (local.get $cols)))
      (local.set $s0 (v128.const i32x4 0 0 0 0)) (local.set $s1 (v128.const i32x4 0 0 0 0))
      (local.set $s2 (v128.const i32x4 0 0 0 0)) (local.set $s3 (v128.const i32x4 0 0 0 0))
      (local.set $c (i32.const 0))
      (block $cd (loop $cl
        (br_if $cd (i32.ge_u (local.get $c) (local.get $cols)))
        (local.set $av (v128.load (i32.add (local.get $a) (local.get $c))))
        (local.set $p (v128.load (i32.add (local.get $w0) (local.get $c))))
        (local.set $s0 (i32x4.add (local.get $s0) (i32x4.extadd_pairwise_i16x8_s (i16x8.add
          (i16x8.extmul_low_i8x16_s (local.get $p) (local.get $av)) (i16x8.extmul_high_i8x16_s (local.get $p) (local.get $av))))))
        (local.set $p (v128.load (i32.add (local.get $w1) (local.get $c))))
        (local.set $s1 (i32x4.add (local.get $s1) (i32x4.extadd_pairwise_i16x8_s (i16x8.add
          (i16x8.extmul_low_i8x16_s (local.get $p) (local.get $av)) (i16x8.extmul_high_i8x16_s (local.get $p) (local.get $av))))))
        (local.set $p (v128.load (i32.add (local.get $w2) (local.get $c))))
        (local.set $s2 (i32x4.add (local.get $s2) (i32x4.extadd_pairwise_i16x8_s (i16x8.add
          (i16x8.extmul_low_i8x16_s (local.get $p) (local.get $av)) (i16x8.extmul_high_i8x16_s (local.get $p) (local.get $av))))))
        (local.set $p (v128.load (i32.add (local.get $w3) (local.get $c))))
        (local.set $s3 (i32x4.add (local.get $s3) (i32x4.extadd_pairwise_i16x8_s (i16x8.add
          (i16x8.extmul_low_i8x16_s (local.get $p) (local.get $av)) (i16x8.extmul_high_i8x16_s (local.get $p) (local.get $av))))))
        (local.set $c (i32.add (local.get $c) (i32.const 16)))
        (br $cl)))
      (i32.store (i32.add (local.get $out) (i32.shl (local.get $r) (i32.const 2))) (call $hsum (local.get $s0)))
      (i32.store (i32.add (local.get $out) (i32.shl (i32.add (local.get $r) (i32.const 1)) (i32.const 2))) (call $hsum (local.get $s1)))
      (i32.store (i32.add (local.get $out) (i32.shl (i32.add (local.get $r) (i32.const 2)) (i32.const 2))) (call $hsum (local.get $s2)))
      (i32.store (i32.add (local.get $out) (i32.shl (i32.add (local.get $r) (i32.const 3)) (i32.const 2))) (call $hsum (local.get $s3)))
      (local.set $r (i32.add (local.get $r) (i32.const 4)))
      (br $quad)))
    (block $tail_done (loop $tail
      (br_if $tail_done (i32.ge_u (local.get $r) (local.get $rows)))
      (i32.store (i32.add (local.get $out) (i32.shl (local.get $r) (i32.const 2)))
        (call $hsum (call $dot (i32.add (local.get $w) (i32.mul (local.get $r) (local.get $cols))) (local.get $a) (local.get $cols))))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $tail))))
;; scores: out[j] = q · K[j] for j < n; q and keys are int16[64] (|x| <= 181, so pairwise sums fit i32).
  (func (export "scores") (param $q i32) (param $kb i32) (param $stride i32) (param $n i32) (param $out i32)
    (local $j i32) (local $kp i32) (local $s v128)
    (local $q0 v128) (local $q1 v128) (local $q2 v128) (local $q3 v128) (local $q4 v128) (local $q5 v128) (local $q6 v128) (local $q7 v128)
    (local.set $q0 (v128.load offset=0 (local.get $q)))   (local.set $q1 (v128.load offset=16 (local.get $q)))
    (local.set $q2 (v128.load offset=32 (local.get $q)))  (local.set $q3 (v128.load offset=48 (local.get $q)))
    (local.set $q4 (v128.load offset=64 (local.get $q)))  (local.set $q5 (v128.load offset=80 (local.get $q)))
    (local.set $q6 (v128.load offset=96 (local.get $q)))  (local.set $q7 (v128.load offset=112 (local.get $q)))
    (local.set $j (i32.const 0)) (local.set $kp (local.get $kb))
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $j) (local.get $n)))
      (local.set $s (i32x4.dot_i16x8_s (local.get $q0) (v128.load offset=0 (local.get $kp))))
      (local.set $s (i32x4.add (local.get $s) (i32x4.dot_i16x8_s (local.get $q1) (v128.load offset=16 (local.get $kp)))))
      (local.set $s (i32x4.add (local.get $s) (i32x4.dot_i16x8_s (local.get $q2) (v128.load offset=32 (local.get $kp)))))
      (local.set $s (i32x4.add (local.get $s) (i32x4.dot_i16x8_s (local.get $q3) (v128.load offset=48 (local.get $kp)))))
      (local.set $s (i32x4.add (local.get $s) (i32x4.dot_i16x8_s (local.get $q4) (v128.load offset=64 (local.get $kp)))))
      (local.set $s (i32x4.add (local.get $s) (i32x4.dot_i16x8_s (local.get $q5) (v128.load offset=80 (local.get $kp)))))
      (local.set $s (i32x4.add (local.get $s) (i32x4.dot_i16x8_s (local.get $q6) (v128.load offset=96 (local.get $kp)))))
      (local.set $s (i32x4.add (local.get $s) (i32x4.dot_i16x8_s (local.get $q7) (v128.load offset=112 (local.get $kp)))))
      (i32.store (i32.add (local.get $out) (i32.shl (local.get $j) (i32.const 2))) (call $hsum (local.get $s)))
      (local.set $kp (i32.add (local.get $kp) (local.get $stride)))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $l))))
  ;; wsum: out[d] = sum_j e[j] * V[j][d] exactly (i64[64]). e[j] <= 4096, |V| <= 32767: blocks of 15 fit in i32.
  (func (export "wsum") (param $e i32) (param $vb i32) (param $stride i32) (param $n i32) (param $out i32)
    (local $j i32) (local $b i32) (local $vp i32) (local $ev v128) (local $d i32) (local $x v128) (local $o i32)
    (local $a0 v128) (local $a1 v128) (local $a2 v128) (local $a3 v128) (local $a4 v128) (local $a5 v128) (local $a6 v128) (local $a7 v128)
    (local $a8 v128) (local $a9 v128) (local $a10 v128) (local $a11 v128) (local $a12 v128) (local $a13 v128) (local $a14 v128) (local $a15 v128)
    (local.set $d (i32.const 0))
    (block $z (loop $zl (br_if $z (i32.ge_u (local.get $d) (i32.const 64)))
      (i64.store (i32.add (local.get $out) (i32.shl (local.get $d) (i32.const 3))) (i64.const 0))
      (local.set $d (i32.add (local.get $d) (i32.const 1))) (br $zl)))
    (local.set $j (i32.const 0)) (local.set $vp (local.get $vb))
    (block $done (loop $blk
      (br_if $done (i32.ge_u (local.get $j) (local.get $n)))
      (local.set $a0 (v128.const i32x4 0 0 0 0)) (local.set $a1 (v128.const i32x4 0 0 0 0)) (local.set $a2 (v128.const i32x4 0 0 0 0)) (local.set $a3 (v128.const i32x4 0 0 0 0))
      (local.set $a4 (v128.const i32x4 0 0 0 0)) (local.set $a5 (v128.const i32x4 0 0 0 0)) (local.set $a6 (v128.const i32x4 0 0 0 0)) (local.set $a7 (v128.const i32x4 0 0 0 0))
      (local.set $a8 (v128.const i32x4 0 0 0 0)) (local.set $a9 (v128.const i32x4 0 0 0 0)) (local.set $a10 (v128.const i32x4 0 0 0 0)) (local.set $a11 (v128.const i32x4 0 0 0 0))
      (local.set $a12 (v128.const i32x4 0 0 0 0)) (local.set $a13 (v128.const i32x4 0 0 0 0)) (local.set $a14 (v128.const i32x4 0 0 0 0)) (local.set $a15 (v128.const i32x4 0 0 0 0))
      (local.set $b (i32.const 0))
      (block $bd (loop $bl
        (br_if $bd (i32.or (i32.ge_u (local.get $b) (i32.const 15)) (i32.ge_u (local.get $j) (local.get $n))))
        (local.set $ev (i32x4.splat (i32.load (i32.add (local.get $e) (i32.shl (local.get $j) (i32.const 2))))))
        (local.set $x (v128.load offset=0 (local.get $vp)))
        (local.set $a0 (i32x4.add (local.get $a0) (i32x4.mul (local.get $ev) (i32x4.extend_low_i16x8_s (local.get $x)))))
        (local.set $a1 (i32x4.add (local.get $a1) (i32x4.mul (local.get $ev) (i32x4.extend_high_i16x8_s (local.get $x)))))
        (local.set $x (v128.load offset=16 (local.get $vp)))
        (local.set $a2 (i32x4.add (local.get $a2) (i32x4.mul (local.get $ev) (i32x4.extend_low_i16x8_s (local.get $x)))))
        (local.set $a3 (i32x4.add (local.get $a3) (i32x4.mul (local.get $ev) (i32x4.extend_high_i16x8_s (local.get $x)))))
        (local.set $x (v128.load offset=32 (local.get $vp)))
        (local.set $a4 (i32x4.add (local.get $a4) (i32x4.mul (local.get $ev) (i32x4.extend_low_i16x8_s (local.get $x)))))
        (local.set $a5 (i32x4.add (local.get $a5) (i32x4.mul (local.get $ev) (i32x4.extend_high_i16x8_s (local.get $x)))))
        (local.set $x (v128.load offset=48 (local.get $vp)))
        (local.set $a6 (i32x4.add (local.get $a6) (i32x4.mul (local.get $ev) (i32x4.extend_low_i16x8_s (local.get $x)))))
        (local.set $a7 (i32x4.add (local.get $a7) (i32x4.mul (local.get $ev) (i32x4.extend_high_i16x8_s (local.get $x)))))
        (local.set $x (v128.load offset=64 (local.get $vp)))
        (local.set $a8 (i32x4.add (local.get $a8) (i32x4.mul (local.get $ev) (i32x4.extend_low_i16x8_s (local.get $x)))))
        (local.set $a9 (i32x4.add (local.get $a9) (i32x4.mul (local.get $ev) (i32x4.extend_high_i16x8_s (local.get $x)))))
        (local.set $x (v128.load offset=80 (local.get $vp)))
        (local.set $a10 (i32x4.add (local.get $a10) (i32x4.mul (local.get $ev) (i32x4.extend_low_i16x8_s (local.get $x)))))
        (local.set $a11 (i32x4.add (local.get $a11) (i32x4.mul (local.get $ev) (i32x4.extend_high_i16x8_s (local.get $x)))))
        (local.set $x (v128.load offset=96 (local.get $vp)))
        (local.set $a12 (i32x4.add (local.get $a12) (i32x4.mul (local.get $ev) (i32x4.extend_low_i16x8_s (local.get $x)))))
        (local.set $a13 (i32x4.add (local.get $a13) (i32x4.mul (local.get $ev) (i32x4.extend_high_i16x8_s (local.get $x)))))
        (local.set $x (v128.load offset=112 (local.get $vp)))
        (local.set $a14 (i32x4.add (local.get $a14) (i32x4.mul (local.get $ev) (i32x4.extend_low_i16x8_s (local.get $x)))))
        (local.set $a15 (i32x4.add (local.get $a15) (i32x4.mul (local.get $ev) (i32x4.extend_high_i16x8_s (local.get $x)))))
        (local.set $vp (i32.add (local.get $vp) (local.get $stride)))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (local.set $b (i32.add (local.get $b) (i32.const 1)))
        (br $bl)))
      (call $flush (local.get $out) (i32.const 0) (local.get $a0)) (call $flush (local.get $out) (i32.const 4) (local.get $a1))
      (call $flush (local.get $out) (i32.const 8) (local.get $a2)) (call $flush (local.get $out) (i32.const 12) (local.get $a3))
      (call $flush (local.get $out) (i32.const 16) (local.get $a4)) (call $flush (local.get $out) (i32.const 20) (local.get $a5))
      (call $flush (local.get $out) (i32.const 24) (local.get $a6)) (call $flush (local.get $out) (i32.const 28) (local.get $a7))
      (call $flush (local.get $out) (i32.const 32) (local.get $a8)) (call $flush (local.get $out) (i32.const 36) (local.get $a9))
      (call $flush (local.get $out) (i32.const 40) (local.get $a10)) (call $flush (local.get $out) (i32.const 44) (local.get $a11))
      (call $flush (local.get $out) (i32.const 48) (local.get $a12)) (call $flush (local.get $out) (i32.const 52) (local.get $a13))
      (call $flush (local.get $out) (i32.const 56) (local.get $a14)) (call $flush (local.get $out) (i32.const 60) (local.get $a15))
      (br $blk))))
  (func $flush (param $out i32) (param $d i32) (param $a v128)
    (local $p i32)
    (local.set $p (i32.add (local.get $out) (i32.shl (local.get $d) (i32.const 3))))
    (i64.store offset=0 (local.get $p) (i64.add (i64.load offset=0 (local.get $p)) (i64.extend_i32_s (i32x4.extract_lane 0 (local.get $a)))))
    (i64.store offset=8 (local.get $p) (i64.add (i64.load offset=8 (local.get $p)) (i64.extend_i32_s (i32x4.extract_lane 1 (local.get $a)))))
    (i64.store offset=16 (local.get $p) (i64.add (i64.load offset=16 (local.get $p)) (i64.extend_i32_s (i32x4.extract_lane 2 (local.get $a)))))
    (i64.store offset=24 (local.get $p) (i64.add (i64.load offset=24 (local.get $p)) (i64.extend_i32_s (i32x4.extract_lane 3 (local.get $a))))))
  ;; requant: out[r] = rshift(rshift(acc[r] * m[r], k[r]) * T, sh), exactly as int_engine.py (k, sh > 0; >> floors).
  (func (export "requant") (param $acc i32) (param $m i32) (param $k i32) (param $rows i32) (param $T i64) (param $sh i64) (param $out i32)
    (local $r i32) (local $o i32) (local $kk i64) (local $p i64)
    (local.set $r (i32.const 0))
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $r) (local.get $rows)))
      (local.set $o (i32.shl (local.get $r) (i32.const 2)))
      (local.set $kk (i64.extend_i32_s (i32.load (i32.add (local.get $k) (local.get $o)))))
      (local.set $p (i64.mul (i64.extend_i32_s (i32.load (i32.add (local.get $acc) (local.get $o))))
                             (i64.extend_i32_s (i32.load (i32.add (local.get $m) (local.get $o))))))
      (local.set $p (i64.shr_s (i64.add (local.get $p) (i64.shl (i64.const 1) (i64.sub (local.get $kk) (i64.const 1)))) (local.get $kk)))
      (local.set $p (i64.mul (local.get $p) (local.get $T)))
      (local.set $p (i64.shr_s (i64.add (local.get $p) (i64.shl (i64.const 1) (i64.sub (local.get $sh) (i64.const 1)))) (local.get $sh)))
      (i32.store (i32.add (local.get $out) (local.get $o)) (i32.wrap_i64 (local.get $p)))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $l))))
)